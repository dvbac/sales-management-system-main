@model SalesManagement.Web.Models.EmployeeViewModel

@{
    ViewData["Title"] = "Chi tiết nhân viên";
}

<div class="container">
    <h1>Chi tiết nhân viên</h1>

    <div class="row">
        <!-- Personal Info -->
        <div class="col-md-5">
            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Hồ sơ</h5>
                </div>
                <div class="card-body">
                    <div class="text-center mb-3">
                        <div class="display-1 text-secondary"><i class="bi bi-person-circle"></i></div>
                    </div>
                    <dl class="row">
                        <dt class="col-sm-4">Họ và tên</dt>
                        <dd class="col-sm-8">@Model.FullName</dd>
                        
                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4">Vai trò</dt>
                        <dd class="col-sm-8"><span class="badge bg-secondary">@Model.Role</span></dd>

                        <dt class="col-sm-4">Chức vụ</dt>
                        <dd class="col-sm-8">@Model.Position</dd>

                        <dt class="col-sm-4">Phòng ban</dt>
                        <dd class="col-sm-8">@Model.Department</dd>
                        
                        <dt class="col-sm-4">Lương</dt>
                        <dd class="col-sm-8">@(Model.BasicSalary.HasValue ? Model.BasicSalary.Value.ToString("C0") : "")</dd>
                        
                        <dt class="col-sm-4">Ngày bắt đầu</dt>
                        <dd class="col-sm-8">@Model.StartWorkingDate?.ToShortDateString()</dd>
                    </dl>
                    <div class="mt-3">
                        <a asp-action="Edit" asp-route-id="@Model.EmployeeId" class="btn btn-warning">Sửa</a>
                        <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Work History -->
        <div class="col-md-7">
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Thông tin nhân sự</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-6">
                            <small class="text-muted d-block">Mã nhân viên</small>
                            <span class="fw-bold">NV-@Model.EmployeeId.ToString("D4")</span>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block">Tài khoản</small>
                            <span class="fw-bold">@Model.Username</span>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block">Phòng ban</small>
                            <span class="fw-bold">@(string.IsNullOrEmpty(Model.Department) ? "Kinh doanh" : Model.Department)</span>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block">Chức vụ</small>
                            <span class="fw-bold">@(string.IsNullOrEmpty(Model.Position) ? "Nhân viên" : Model.Position)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
