@using SalesManagement.Web.Models
@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi";
}

<div class="container py-5 text-center my-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm border-0 rounded-4 p-5">
                <div class="mb-3">
                    <i class="bi bi-exclamation-triangle-fill text-warning display-3"></i>
                </div>
                <h2 class="fw-bold text-danger mb-3">Đã xảy ra lỗi</h2>
                <p class="text-muted mb-4">
                    Hệ thống gặp sự cố khi xử lý yêu cầu của bạn. Vui lòng thử lại sau.
                </p>

                @if (Model.ShowRequestId)
                {
                    <div class="alert alert-light border small text-muted mb-4">
                        <strong>Mã yêu cầu (Request ID):</strong> <code>@Model.RequestId</code>
                    </div>
                }

                <div>
                    <a href="/" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-house-door me-2"></i> Về trang chủ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
