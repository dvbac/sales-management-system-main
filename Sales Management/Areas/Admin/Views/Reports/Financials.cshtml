@model SalesManagement.Web.Areas.Admin.Models.FinancialReportViewModel
@{
    ViewData["Title"] = "Báo cáo Tài chính";
    var vn = new System.Globalization.CultureInfo("vi-VN");
}

<h3 class="fw-bold text-dark mb-4">
    <i class="bi bi-cash-stack text-primary me-2"></i>Báo cáo &amp; Phân tích
</h3>

<partial name="_ReportTabs" />

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label for="startDate" class="form-label fw-bold">Từ ngày</label>
                <input type="date" name="startDate" id="startDate" class="form-control"
                       value="@Model.StartDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-4">
                <label for="endDate" class="form-label fw-bold">Đến ngày</label>
                <input type="date" name="endDate" id="endDate" class="form-control"
                       value="@Model.EndDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary">Lọc báo cáo</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <h6 class="text-muted">Doanh thu đã thanh toán</h6>
        <div class="h4 fw-bold text-success">@Model.NetRevenue.ToString("C0", vn)</div>
        <p class="text-muted small mb-0">Tổng hợp theo ngày tạo đơn hàng, không phải ngày thu hoặc hoàn tiền.</p>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3">
        <h6 class="m-0 fw-bold">Trạng thái thanh toán đơn hàng</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr><th>Trạng thái</th><th>Số đơn</th><th class="text-end">Tổng tiền</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.InvoiceStats)
                    {
                        var label = item.Status switch
                        {
                            "Paid" => "Đã thanh toán",
                            "Pending" => "Chờ thanh toán",
                            _ => "Đã ghi nhận hoàn tiền"
                        };
                        <tr>
                            <td>@label</td>
                            <td>@item.Count</td>
                            <td class="text-end fw-bold">@item.TotalAmount.ToString("C0", vn)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
