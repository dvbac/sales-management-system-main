@model SalesManagement.DAL.Entities.Promotion

@{
    ViewData["Title"] = "Tạo mã giảm giá mới";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold text-dark">Tạo mã giảm giá mới</h3>
                <p class="text-muted mb-0">Điền thông tin để tạo chương trình khuyến mãi mới</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
                <i class="bi bi-arrow-left me-2"></i> Trở về
            </a>
        </div>

        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Code" class="form-label fw-semibold">Mã giảm giá</label>
                            <input asp-for="Code" class="form-control rounded-3" placeholder="VD: SUMMER2024" />
                            <span asp-validation-for="Code" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-semibold">Trạng thái</label>
                            <select asp-for="Status" class="form-select rounded-3">
                                <option value="Active">Hoạt động</option>
                                <option value="Disabled">Tạm ngưng</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DiscountType" class="form-label fw-semibold">Loại giảm giá</label>
                            <select asp-for="DiscountType" id="discountTypeSelect" class="form-select rounded-3">
                                <option value="Percent">Theo phần trăm (%)</option>
                                <option value="Amount">Theo số tiền cố định (VNĐ)</option>
                            </select>
                            <span asp-validation-for="DiscountType" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Value" id="valueLabel" class="form-label fw-semibold">Giá trị giảm</label>
                            <div class="input-group">
                                <input asp-for="Value" class="form-control rounded-start-3" type="number" step="any" required />
                                <span class="input-group-text rounded-end-3" id="valueUnit">₫</span>
                            </div>
                            <span asp-validation-for="Value" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label fw-semibold">Ngày bắt đầu</label>
                            <input asp-for="StartDate" class="form-control rounded-3" type="datetime-local" />
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EndDate" class="form-label fw-semibold">Ngày kết thúc</label>
                            <input asp-for="EndDate" class="form-control rounded-3" type="datetime-local" />
                            <span asp-validation-for="EndDate" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MinOrderValue" class="form-label fw-semibold">Giá trị đơn hàng tối thiểu</label>
                            <input asp-for="MinOrderValue" class="form-control rounded-3" type="number" step="0.01" />
                            <span asp-validation-for="MinOrderValue" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mt-4 d-flex justify-content-end gap-2">
                        <button type="reset" class="btn btn-light rounded-pill px-4">Làm mới</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4">
                            <i class="bi bi-check-lg me-2"></i> Tạo mã
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function updateDiscountTypeUI() {
            var select = document.getElementById('discountTypeSelect');
            if (!select) return;
            var isPercent = select.value === 'Percent';
            var unit = document.getElementById('valueUnit');
            var label = document.getElementById('valueLabel');
            if (unit) unit.textContent = isPercent ? '%' : '₫';
            if (label) label.textContent = isPercent ? 'Giá trị giảm (%)' : 'Giá trị giảm (VNĐ)';
        }
        document.getElementById('discountTypeSelect')?.addEventListener('change', updateDiscountTypeUI);
        document.addEventListener('DOMContentLoaded', updateDiscountTypeUI);
        updateDiscountTypeUI();
    </script>
}
